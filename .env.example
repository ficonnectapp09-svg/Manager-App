# =============================================================================
# FORGE INDIA CONNECT (FIC) - MANAGER MOBILE APP ENVIRONMENT TEMPLATE
# =============================================================================
# 1. CORE APPLICATION & RUNTIME ENVIRONMENT
NODE_ENV=production
PORT=8005
APP_NAME=FIC_Manager_Mobile_App
APP_VERSION=1.0.0
APP_PUBLIC_URL=https://manager-website.onrender.com
API_BASE_URL=https://manager-website.onrender.com/api
SOCKET_URL=wss://manager-website.onrender.com/ws
VITE_API_URL=https://manager-website.onrender.com/api

# 2. MAPS & LOCATION
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# 3. PUSH NOTIFICATIONS (Firebase)
FIREBASE_PROJECT_ID=fic-connect-app
FCM_SERVER_KEY=your_fcm_server_key

# 4. MONITORING & LOGGING
LOG_LEVEL=info
